# ─────────────────────────────────────────────────────────────
#  fableclip — one config, three variables.
#
#  Copy this to .env and pick a provider below. The default is a
#  free hosted model: no GPU, no download, no credit card.
#  Getting a key takes about a minute.
#
#  Prefer nothing leaving your machine? Jump to LOCAL at the end.
# ─────────────────────────────────────────────────────────────

# ── OpenRouter — the default ─────────────────────────────────
# Free key (no card): https://openrouter.ai/keys
# The free models are the ones ending in `:free`. List them
# without a key:
#   curl -s https://openrouter.ai/api/v1/models \
#     | grep -o '"id":"[^"]*:free"'
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-26b-a4b-it:free
LLM_API_KEY=

# ── Groq — free, and very fast ───────────────────────────────
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=gsk_...

# ── Google AI Studio — free, huge context ────────────────────
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=AIza...

# ── LOCAL — nothing leaves your machine ──────────────────────
#   brew install --cask ollama
#   OLLAMA_CONTEXT_LENGTH=16384 ollama serve
#   ollama pull qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=

# ── Optional ─────────────────────────────────────────────────
# PORT=4325                 # host port
# LLM_WINDOW_CHARS=9000     # transcript per model request
# WHISPER_MODEL=base        # only used when a video has no captions
# RENDER_CONCURRENCY=3      # clips cut at once
